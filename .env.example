# Discord 配置
# 從 https://discord.com/developers/applications 獲取
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_test_server_id_here

# 資料庫配置
# PostgreSQL 連接字串
# 格式: postgresql://[使用者]:[密碼]@[主機]:[端口]/[資料庫名稱]
DATABASE_URL="postgresql://postgres:password@localhost:5432/mementia?schema=public"

# AI 配置
# 從 https://platform.openai.com/api-keys 獲取
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# 可選模型: gpt-4o, gpt-4-turbo, gpt-3.5-turbo

# 應用配置
NODE_ENV=development
# 選項: development | production | test

# 時區設定（台灣時區）
TZ=Asia/Taipei

# 日誌等級
LOG_LEVEL=info
# 選項: debug | info | warn | error

# 功能開關
ENABLE_DAILY_REMINDER=true
ENABLE_AUTO_REVIEW=true
ENABLE_CHALLENGES=true

# 提醒時間設定（24小時制）
DEFAULT_REMINDER_TIME=21:00

# Spotify 整合（可選）
# 從 https://developer.spotify.com/dashboard 獲取
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# 速率限制（每位使用者每分鐘可執行的指令數）
RATE_LIMIT_PER_MINUTE=10

# AI 回應設定
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.7

# 挑戰系統設定
CHALLENGE_ASSIGN_HOUR=9
# 每天幾點分配新挑戰（24小時制）

CHALLENGES_PER_WEEK=3
# 每週分配多少個挑戰

# 回顧生成時間
WEEKLY_REVIEW_DAY=0
# 0=週日, 1=週一, ..., 6=週六

MONTHLY_REVIEW_DAY=1
# 每月第幾天生成月報
